<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Quote Workflow - Brooke & Maisy" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= tag.meta name: "margin-pin", content: Rails.application.config.margin_pin %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-theme-100 text-gray-900 font-sans min-h-screen" data-controller="workflow-nav">
    <%# Slide-out admin nav overlay %>
    <div data-workflow-nav-target="overlay"
         class="hidden fixed inset-0 bg-black/40 z-40"
         data-action="click->workflow-nav#close">
    </div>

    <%# Slide-out admin nav panel %>
    <aside data-workflow-nav-target="panel"
           class="fixed top-0 left-0 h-full w-72 bg-theme-500 z-50 transform transition-transform duration-200 translate-x-[-100%] overflow-y-auto">
      <div class="px-6 py-6 border-b border-white/10 flex items-center justify-between">
        <div>
          <p class="font-serif text-xl font-semibold text-white">Brooke &amp; Maisy</p>
          <p class="text-xs uppercase tracking-[0.18em] text-theme-200 mt-0.5">Admin</p>
        </div>
        <button data-action="click->workflow-nav#close"
                class="text-theme-200 hover:text-white p-1"
                aria-label="Close navigation">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <nav class="px-3 py-4 space-y-1">
        <%= link_to "Dashboard", admin_root_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Clients", admin_clients_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Quotes", admin_quotes_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Templates", admin_quote_templates_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Projects", admin_projects_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Products", admin_products_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Manufacturers", admin_manufacturers_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Swatches", admin_swatches_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Promo Codes", admin_promo_codes_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
        <%= link_to "Messages", admin_messages_path, class: "flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-theme-100 hover:bg-white/10 hover:text-white transition-colors" %>
      </nav>
    </aside>

    <%# Top bar — hamburger + brand + user %>
    <header class="sticky top-0 z-30 bg-theme-500 border-b border-white/10">
      <div class="flex items-center justify-between px-4 py-3">
        <div class="flex items-center gap-3">
          <button data-action="click->workflow-nav#toggle"
                  class="text-theme-100 hover:text-white p-1.5 rounded-lg hover:bg-white/10 transition-colors"
                  aria-label="Open navigation menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <p class="font-serif text-lg font-semibold text-white">Quote Workflow</p>
        </div>
        <div class="flex items-center gap-3 text-sm text-theme-200">
          <% if current_user %>
            <span><%= current_user.email %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, form: { class: "inline" }, class: "text-theme-200 hover:text-white transition-colors" %>
          <% end %>
        </div>
      </div>

      <%# Stepper slot — views set content_for(:stepper) %>
      <%= yield(:stepper) %>
    </header>

    <%# Flash messages %>
    <div class="fixed top-20 right-4 z-50 space-y-2" data-controller="flash-messages">
      <%= render "shared/flash_messages" %>
    </div>

    <%# Main content %>
    <main class="px-4 sm:px-6 lg:px-10 py-6 max-w-6xl w-full">
      <%= yield %>
    </main>
  </body>
</html>
