<!DOCTYPE html>
<html>
  <head>
    <title>Brooke & Maisy — Installer</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-gray-50 font-sans antialiased">
    <header class="bg-theme-500 text-white px-4 py-3 flex items-center justify-between sticky top-0 z-10">
      <span class="font-serif text-lg">Brooke &amp; Maisy</span>
      <div class="flex items-center gap-3">
        <span class="text-sm text-theme-200"><%= current_user.display_name %></span>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              class: "text-sm text-theme-200 hover:text-white bg-transparent border-0 cursor-pointer" %>
      </div>
    </header>

    <main class="max-w-lg mx-auto px-4 py-6">
      <%= yield %>
    </main>
  </body>
</html>