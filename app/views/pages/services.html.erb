<% content_for(:title, "Services - Brooke & Maisy Interior Designs") %>

<%# Hero — Window Fashion Styling %>
<section class="relative bg-theme-500 overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-theme-300 blur-3xl translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full bg-theme-400 blur-3xl -translate-x-1/3 translate-y-1/3"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="max-w-3xl">
      <p class="text-theme-200 text-sm font-medium uppercase tracking-[0.2em] mb-4">
        Brooke &amp; Maisy Interior Designs
      </p>
      <h1 class="font-serif text-4xl lg:text-6xl font-semibold text-white leading-tight mb-6">
        Window Fashion Styling
      </h1>
      <p class="text-lg lg:text-xl text-theme-100 leading-relaxed mb-8 max-w-2xl">
        From bespoke drapery to precision-fitted blinds and shutters, we design window treatments that
        transform light, privacy, and architecture into a finished statement. Every project begins with
        an in-home consultation and ends with professional installation.
      </p>
      <div class="flex flex-wrap gap-4">
        <%= link_to "Book a Consultation", contact_path,
              class: "inline-block bg-white hover:bg-theme-100 text-theme-500 px-6 py-3 rounded-lg font-medium transition-colors" %>
        <%= link_to "View Our Work", portfolio_path,
              class: "inline-block border border-theme-300 hover:border-theme-100 text-theme-100 hover:text-white px-6 py-3 rounded-lg font-medium transition-colors" %>
      </div>
    </div>

    <%# Feature highlights %>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mt-16 pt-10 border-t border-theme-400">
      <div>
        <p class="font-serif text-3xl font-semibold text-white mb-1">In-Home</p>
        <p class="text-sm text-theme-200">Consultation &amp; measurement</p>
      </div>
      <div>
        <p class="font-serif text-3xl font-semibold text-white mb-1">Custom</p>
        <p class="text-sm text-theme-200">Drapery, blinds &amp; shutters</p>
      </div>
      <div>
        <p class="font-serif text-3xl font-semibold text-white mb-1">Pro</p>
        <p class="text-sm text-theme-200">Installation by experts</p>
      </div>
      <div>
        <p class="font-serif text-3xl font-semibold text-white mb-1">SC</p>
        <p class="text-sm text-theme-200">Licensed &amp; insured</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-theme-100 py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl lg:text-4xl font-semibold text-theme-500 mb-4">Our Services</h2>
    <p class="text-xl text-gray-600 mb-12 max-w-2xl">
      Design services for every budget. From a single room refresh to full home renovations — personalized solutions tailored to your needs.
    </p>

    <% if @services.any? %>
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <% @services.each do |service| %>
          <div class="bg-white rounded-xl p-8 shadow-sm">
            <div class="w-14 h-14 rounded-lg bg-gray-100 mb-5 flex items-center justify-center">
              <% case service.icon_name %>
              <% when "home" %>
                <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
              <% when "paint", "brush" %>
                <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              <% when "sparkles", "star" %>
                <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              <% else %>
                <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                </svg>
              <% end %>
            </div>
            <h3 class="text-xl font-semibold text-theme-500 mb-3"><%= service.title %></h3>
            <% if service.description.present? %>
              <p class="text-gray-600 leading-relaxed mb-4"><%= service.description %></p>
            <% end %>
            <% if service.bullet_list.any? %>
              <ul class="text-gray-600 text-sm space-y-2">
                <% service.bullet_list.each do |point| %>
                  <li>• <%= point %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-gray-400 text-lg">Service details coming soon.</p>
      </div>
    <% end %>
  </div>
</section>

<%# FAQ / Not Sure Section %>
<section class="bg-[#FAF9F6] py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl font-semibold text-theme-500 mb-4">Not sure which package fits?</h2>
    <p class="text-gray-600 text-lg mb-8 max-w-2xl mx-auto">
      Let's talk about your project — no pressure, just a conversation about your vision and how we can bring it to life.
    </p>
    <%= link_to "Book a Free Consultation", contact_path,
          class: "inline-block bg-theme-400 hover:bg-theme-500 text-white px-8 py-4 rounded-md font-medium text-lg transition-colors" %>
  </div>
</section>