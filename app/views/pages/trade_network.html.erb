<% content_for(:title, "Trade Network - Brooke & Maisy Interior Designs") %>

<%# Header Section %>
<section class="bg-theme-100 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl lg:text-4xl font-semibold text-theme-500">Trade Network</h1>
      <p class="text-gray-600 mt-1">Trusted professionals we refer to clients</p>
    </div>

    <%# Filter Buttons %>
    <div class="flex flex-wrap gap-2">
      <%= link_to "All (#{@trade_partners.count})", trade_network_path,
            class: "px-4 py-2 rounded-md text-sm font-medium transition-colors #{params[:type].blank? ? 'bg-theme-400 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% TradePartner::TRADE_TYPES.each do |type| %>
        <% count = @trade_partners.select { |tp| tp.trade_type == type }.size %>
        <% next if count.zero? %>
        <%= link_to "#{type.titleize} (#{count})", trade_network_path(type: type),
              class: "px-4 py-2 rounded-md text-sm font-medium transition-colors #{params[:type] == type ? 'bg-theme-400 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
      <% end %>
    </div>
  </div>
</section>

<%# Tradespeople Listings %>
<section class="bg-theme-100 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @trade_partners.any? %>
      <div class="grid md:grid-cols-2 gap-6">
        <% @trade_partners.each do |partner| %>
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7 text-theme-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex items-start justify-between">
                  <div>
                    <h3 class="text-lg font-semibold text-theme-500"><%= partner.name %></h3>
                    <p class="text-gray-600 text-sm">
                      <%= partner.trade_type_label %>
                      <% if partner.years_experience&.positive? %>
                        • <%= pluralize(partner.years_experience, "year") %> experience
                      <% end %>
                    </p>
                  </div>
                  <% if partner.rating&.positive? %>
                    <div class="flex items-center gap-1 text-theme-400">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      <span class="text-sm font-medium text-gray-700"><%= partner.rating.to_f %></span>
                    </div>
                  <% end %>
                </div>
                <% if partner.description.present? %>
                  <p class="text-gray-600 text-sm mt-2 mb-4"><%= partner.description %></p>
                <% end %>
                <div class="flex flex-wrap gap-3 mt-4">
                  <% if partner.phone.present? %>
                    <a href="tel:<%= partner.phone.gsub(/[^0-9]/, '') %>"
                       class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 text-gray-700 rounded-md text-sm hover:bg-gray-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.397 2.397a.965.965 0 01-.707.293H7.688a.965.965 0 01-.707-.293l-2.397-2.397A1 1 0 01.484 9.557l1.498 4.493a1 1 0 01.948.684H17a2 2 0 012 2v2" />
                      </svg>
                      <%= partner.phone %>
                    </a>
                  <% end %>
                  <% if partner.email.present? %>
                    <a href="mailto:<%= partner.email %>"
                       class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 text-gray-700 rounded-md text-sm hover:bg-gray-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      Email
                    </a>
                  <% end %>
                  <% if partner.website.present? %>
                    <a href="<%= partner.website %>" target="_blank" rel="noopener"
                       class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 text-gray-700 rounded-md text-sm hover:bg-gray-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                      Website
                    </a>
                  <% end %>
                  <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-100 text-gray-600 rounded-md text-sm">
                    <%= pluralize(partner.jobs_referred, "job") %> referred
                  </span>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-gray-400 text-lg">No trade partners to show yet.</p>
        <p class="text-gray-400 text-sm mt-1">Check back soon — we're building our network.</p>
      </div>
    <% end %>
  </div>
</section>