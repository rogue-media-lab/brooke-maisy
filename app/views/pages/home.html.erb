<% content_for(:title, "Brooke & Maisy Interior Designs - Professional Interior Design in Fort Mill, SC") %>
<% content_for(:description, "Professional interior design services in Fort Mill, SC serving the Greater Charlotte Area. Transform your space into something beautiful.") %>

<%# Hero Section %>
<section class="bg-linear-to-br from-theme-100 to-theme-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-center">

      <%# Hero Content %>
      <div class="flex-1">
        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-semibold text-theme-500 leading-tight mb-6" style="letter-spacing: -1.5px;">
          Transform your space into something beautiful
        </h1>
        <p class="text-lg lg:text-xl text-gray-900 leading-relaxed mb-8 max-w-lg">
          Professional interior design services tailored to your lifestyle. Let me help you create a home you'll love coming home to.
        </p>
        <div class="flex flex-wrap gap-4">
          <%= link_to "Start Your Project", contact_path,
                class: "bg-theme-500 hover:bg-theme-200 hover:text-theme-400 text-white px-6 py-3 rounded-md font-medium transition-colors" %>
          <%= link_to "View Portfolio", portfolio_path,
                class: "border border-theme-500 bg-white text-theme-500 hover:bg-theme-200 px-6 py-3 rounded-md font-medium transition-colors" %>
        </div>
      </div>

      <%# Hero Image %>
      <div class="flex-1 w-full lg:w-auto">
        <div class="aspect-7/6 rounded-xl overflow-hidden border-4 border-theme-300 p-1 bg-white shadow-xl">
          <%= image_tag "reference/blue-white-living-room.jpg", alt: "Beautiful blue and white living room interior design", class: "w-full h-full object-cover rounded-lg" %>
        </div>
      </div>

    </div>
  </div>
</section>

<%# Services Section %>
<section class="bg-theme-100 py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl lg:text-4xl font-semibold text-theme-500 mb-12">Services</h2>

    <div class="grid md:grid-cols-3 gap-8">
      <% @services.each do |service| %>
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <div class="w-14 h-14 rounded-lg bg-gray-100 mb-5 flex items-center justify-center">
            <% case service.icon_name %>
            <% when "home" %>
              <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            <% when "paint", "brush" %>
              <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            <% when "sparkles", "star" %>
              <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
            <% else %>
              <svg class="w-7 h-7 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
              </svg>
            <% end %>
          </div>
          <h3 class="text-xl font-semibold text-theme-500 mb-3"><%= service.title %></h3>
          <p class="text-gray-600 leading-relaxed"><%= service.description %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# Trade Network Teaser — only if partners exist %>
<% if @featured_trade_partners.any? %>
  <section class="bg-theme-100 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-2xl lg:text-3xl font-semibold text-theme-500">Trade Network</h2>
        <%= link_to "View Network →", trade_network_path, class: "text-theme-500 font-medium hover:underline" %>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <% @featured_trade_partners.each do |partner| %>
          <div class="bg-white rounded-xl p-6 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1"><%= partner.trade_type_label %></p>
            <h3 class="text-lg font-semibold text-theme-500"><%= partner.name %></h3>
            <% if partner.rating&.positive? %>
              <div class="flex items-center gap-1 text-theme-400 mt-1">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                <span class="text-sm font-medium text-gray-700"><%= partner.rating.to_f %></span>
              </div>
            <% end %>
            <p class="text-gray-500 text-sm mt-2"><%= pluralize(partner.jobs_referred, "job") %> referred</p>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<%# Portfolio Section %>
<section class="bg-white py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center mb-12">
      <h2 class="text-3xl lg:text-4xl font-semibold text-theme-500" style="letter-spacing: -1px;">Portfolio</h2>
      <%= link_to "View All Projects →", portfolio_path, class: "text-theme-500 font-medium hover:underline" %>
    </div>

    <div class="grid md:grid-cols-3 gap-6">

      <% @featured_projects.each do |project| %>
        <% if project.photos.attached? %>
          <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-200 relative cursor-pointer hover:opacity-90 transition-opacity group" data-action="click->lightbox#open">
            <%= image_tag project.photos.last, class: "w-full h-full object-cover", alt: "#{project.title} interior design" %>
            <div class="absolute bottom-0 left-0 right-0 bg-black/50 text-white px-4 py-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <span class="text-sm font-medium"><%= project.title %></span>
            </div>
          </div>
        <% end %>
      <% end %>

      <% remaining = 3 - @featured_projects.count { |p| p.photos.attached? } %>
      <% if remaining > 0 %>
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-200 relative cursor-pointer hover:opacity-90 transition-opacity" data-action="click->lightbox#open">
          <%= image_tag "reference/luxurious-foyer-mural.jpg", class: "w-full h-full object-cover", alt: "Luxurious foyer with hand-painted mural" %>
        </div>
      <% end %>
      <% if remaining > 1 %>
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-200 relative cursor-pointer hover:opacity-90 transition-opacity" data-action="click->lightbox#open">
          <%= image_tag "reference/modern-bathroom-vanity.jpg", class: "w-full h-full object-cover", alt: "Modern bathroom vanity design" %>
        </div>
      <% end %>
      <% if remaining > 2 %>
        <div class="aspect-[4/3] rounded-xl overflow-hidden bg-gray-200 relative cursor-pointer hover:opacity-90 transition-opacity" data-action="click->lightbox#open">
          <%= image_tag "reference/rustic-dining-table.jpg", class: "w-full h-full object-cover", alt: "Rustic dining table setting" %>
        </div>
      <% end %>

    </div>
  </div>
</section>


<%# Contact CTA Section %>
<section class="bg-theme-500 text-white py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl lg:text-4xl font-semibold mb-4" style="letter-spacing: -1px;">Let's create something beautiful</h2>
    <p class="text-white text-lg mb-8 max-w-2xl mx-auto">
      Book a free 30-minute consultation to discuss your project — no pressure, just a conversation about your vision.
    </p>
    <%= link_to "Book a Free Consultation", contact_path,
          class: "inline-block bg-theme-200 hover:bg-theme-100 text-gray-900 px-8 py-4 rounded-md font-medium text-lg transition-colors" %>
  </div>
</section>