<%= form_with model: [:admin, @quote], class: "space-y-6" do |f| %>
  <%= render "admin/clients/client_dropdown", form: f, field_name: :client_id, selected_id: @quote.client_id || params[:new_client_id], clients: @clients, return_to: request.fullpath %>
  <% if @projects && @projects.any? %>
    <div>
      <%= f.label :project_id, "Project (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :project_id, @projects, :id, :title,
            { prompt: "Standalone quote (no project)" },
            class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
  <% end %>
  <div>
    <%= f.label :tax_rate, "Tax Rate", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :tax_rate, step: 0.001, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "0.06 = 6%" %>
    <p class="text-xs text-gray-400 mt-1">Default: 6% SC. Leave blank to use default.</p>
  </div>
  <div>
    <%= f.label :deposit_percentage, "Deposit %", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :deposit_percentage, step: 1, min: 0, max: 100, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "50" %>
    <p class="text-xs text-gray-400 mt-1">Typically 50% due at order.</p>
  </div>
  <div>
    <%= f.label :valid_until, "Valid Until", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.date_field :valid_until, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @quote.persisted? ? admin_quote_path(@quote) : admin_quotes_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>