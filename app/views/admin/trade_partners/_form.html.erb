<%= form_with model: [:admin, trade_partner], class: "space-y-6" do |form| %>
  <% if trade_partner.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <p class="text-red-700 text-sm font-medium"><%= pluralize(trade_partner.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-2 list-disc list-inside text-red-600 text-sm">
        <% trade_partner.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Identity %>
  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Identity</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= form.label :trade_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :trade_type, TradePartner::TRADE_TYPES.map { |t| [t.titleize, t] }, {},
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
    </div>
    <div class="mt-4">
      <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 3,
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
    </div>
  </div>

  <%# Contact %>
  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Contact</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :phone, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
    </div>
    <div class="mt-4">
      <%= form.label :website, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.url_field :website, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm", placeholder: "https://" %>
    </div>
  </div>

  <%# Stats %>
  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Stats</h3>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= form.label :years_experience, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :years_experience, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= form.label :rating, "Rating (0–5)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :rating, step: 0.1, min: 0, max: 5,
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= form.label :jobs_referred, "Jobs referred", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :jobs_referred, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
    </div>
  </div>

  <%# Settings %>
  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Settings</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :display_order, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :display_order, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-center gap-3 pt-6">
        <%= form.check_box :active, class: "rounded border-gray-300 text-theme-500 focus:ring-theme-400" %>
        <%= form.label :active, "Active (visible on public site)", class: "text-sm font-medium text-gray-700" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit trade_partner.persisted? ? "Save changes" : "Add trade partner",
          class: "bg-theme-500 hover:bg-theme-400 text-white font-semibold px-6 py-2.5 rounded-lg cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_trade_partners_path,
          class: "text-gray-500 hover:text-gray-700 text-sm font-medium px-4 py-2.5" %>
  </div>
<% end %>