<%= form_with model: [:admin, @swatch], class: "space-y-6" do |f| %>
  <div>
    <%= f.label :manufacturer_id, "Manufacturer", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :manufacturer_id, @manufacturers, :id, :name, { prompt: "Select..." }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
  </div>
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
    </div>
    <div>
      <%= f.label :hex, "Hex Code", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :hex, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500 font-mono", placeholder: "#FF0000", pattern: "#[0-9A-Fa-f]{6}" %>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :category, [["Blackout", "blackout"], ["Light Filtering", "light_filtering"], ["Sheer", "sheer"], ["Solid", "solid"], ["Pattern/Print", "pattern_print"], ["Liner", "liner"]], { include_blank: true }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :color_range, "Color Range", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :color_range, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "whites_offwhites" %>
    </div>
  </div>
  <div>
    <%= f.label :image_url, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :image_url, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div class="flex gap-6">
    <div class="flex items-center"><%= f.check_box :is_new, class: "rounded border-gray-300 text-theme-500 focus:ring-theme-500" %><%= f.label :is_new, "New", class: "ml-2 text-sm text-gray-700" %></div>
    <div class="flex items-center"><%= f.check_box :is_active, class: "rounded border-gray-300 text-theme-500 focus:ring-theme-500" %><%= f.label :is_active, "Active", class: "ml-2 text-sm text-gray-700" %></div>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @swatch.persisted? ? admin_swatch_path(@swatch) : admin_swatches_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>