<% content_for(:title, "Swatches - Admin") %>

<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="font-serif text-3xl font-semibold text-theme-500">Swatches</h1>
    <p class="text-gray-500 mt-1"><%= pluralize(@swatches.size, "swatch") %></p>
  </div>
  <%= link_to "Add swatch", new_admin_swatch_path,
        class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors" %>
</div>

<% if @swatches.any? %>
  <div class="bg-white rounded-xl border border-theme-100 overflow-hidden">
    <div class="grid grid-cols-12 px-5 py-3 bg-theme-100 text-[11px] font-semibold uppercase tracking-wider text-gray-400">
      <div class="col-span-1"></div>
      <div class="col-span-3">Name</div>
      <div class="col-span-2">Manufacturer</div>
      <div class="col-span-2">Category</div>
      <div class="col-span-2">Color Range</div>
      <div class="col-span-2">Hex</div>
    </div>
    <% @swatches.each do |s| %>
      <%= link_to admin_swatch_path(s), class: "grid grid-cols-12 px-5 py-4 items-center border-b border-gray-50 last:border-0 hover:bg-theme-100" do %>
        <div class="col-span-1"><span class="inline-block w-6 h-6 rounded border border-gray-200" style="background-color: <%= s.hex %>"></span></div>
        <div class="col-span-3 font-medium text-theme-500"><%= s.name %></div>
        <div class="col-span-2 text-sm text-gray-500"><%= s.manufacturer.name %></div>
        <div class="col-span-2 text-sm text-gray-500"><%= s.category.presence || "—" %></div>
        <div class="col-span-2 text-sm text-gray-500"><%= s.color_range&.titleize || "—" %></div>
        <div class="col-span-2 text-sm text-gray-500 font-mono"><%= s.hex.presence || "—" %></div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-theme-100 p-12 text-center text-gray-400">
    <p>No swatches yet. Add swatches to build your color library.</p>
  </div>
<% end %>