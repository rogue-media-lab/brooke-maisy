<%= turbo_frame_tag "product_selection_form" do %>
  <div class="bg-white rounded-lg border border-theme-100 p-4 mt-3">
    <%= form_with model: [ :admin, project, presentation, product_selection ],
          class: "space-y-3" do |f| %>
      <% if product_selection.errors.any? %>
        <div class="text-sm text-red-600">
          <%= product_selection.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Product name", class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name,
              class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :description, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.text_area :description, rows: 2,
              class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :vendor, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :vendor,
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :price, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.number_field :price, step: 0.01,
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :quantity, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.number_field :quantity, min: 1,
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :status, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.select :status, ProductSelection.statuses.keys.map { |s| [s.titleize, s] }, {},
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :room, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :room, placeholder: "e.g. Living Room",
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :product_url, "Product URL", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.url_field :product_url,
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
      </div>

      <div>
        <%= f.label :image, class: "block text-xs font-medium text-gray-700 mb-1" %>
        <%= f.file_field :image, direct_upload: true,
              class: "w-full text-sm file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-theme-100 file:text-theme-500 file:text-xs file:font-medium hover:file:bg-theme-200" %>
      </div>

      <div class="flex items-center gap-2">
        <%= f.submit (product_selection.persisted? ? "Update" : "Add"),
              class: "bg-theme-500 hover:bg-theme-400 text-white text-xs font-semibold px-3 py-1.5 rounded-lg cursor-pointer transition-colors" %>
        <%= link_to "Cancel",
              admin_project_design_presentation_path(project, presentation),
              class: "text-xs text-gray-500 hover:text-theme-500" %>
      </div>
    <% end %>
  </div>
<% end %>
