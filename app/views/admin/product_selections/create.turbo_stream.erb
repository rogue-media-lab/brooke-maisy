<%= turbo_stream.append "product_selections_list" do %>
  <%= render "admin/product_selections/product_selection_card", product: @product_selection, project: @project, presentation: @presentation %>
<% end %>

<%= turbo_stream.remove "product_selections_empty" %>

<%= turbo_stream.update "product_selection_form" do %>
  <%= link_to "Add product", new_admin_project_design_presentation_product_selection_path(@project, @presentation),
        class: "inline-flex items-center gap-1.5 text-sm text-theme-500 hover:text-theme-400 font-medium" %>
<% end %>
