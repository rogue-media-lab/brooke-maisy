<%
  styles = {
    "discovery"   => { label: "Discovery",   badge: "bg-theme-200 text-theme-500" },
    "design"      => { label: "Design",      badge: "bg-theme-200 text-theme-500" },
    "in_progress" => { label: "In Progress", badge: "bg-theme-200 text-theme-500" },
    "complete"    => { label: "Complete",    badge: "bg-theme-200 text-theme-500" },
    "draft"       => { label: "Draft",       badge: "bg-gray-100 text-gray-600" },
    "published"   => { label: "Published",   badge: "bg-green-100 text-green-700" },
    "archived"    => { label: "Archived",    badge: "bg-yellow-100 text-yellow-700" },
    "proposed"    => { label: "Proposed",    badge: "bg-blue-50 text-blue-600" },
    "approved"    => { label: "Approved",    badge: "bg-green-100 text-green-700" },
    "rejected"    => { label: "Rejected",    badge: "bg-red-100 text-red-700" }
  }
  s = styles[status] || { label: status.to_s.titleize, badge: "bg-gray-100 text-gray-700" }
%>
<span class="text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap <%= s[:badge] %>"><%= s[:label] %></span>
