<% content_for(:title, "#{@project.title} - Presentations") %>

<%= link_to admin_project_path(@project), class: "inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-theme-500 mb-4" do %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
  Back to project
<% end %>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="font-serif text-3xl font-semibold text-theme-500">Design Presentations</h1>
    <p class="text-gray-500 mt-1"><%= @project.title %> · <%= @project.client.display_name %></p>
  </div>
  <%= link_to "New presentation", new_admin_project_design_presentation_path(@project),
        class: "text-sm font-medium px-3 py-2 rounded-lg bg-theme-500 text-white hover:bg-theme-400 whitespace-nowrap transition-colors" %>
</div>

<% if @presentations.any? %>
  <div class="space-y-3">
    <% @presentations.each do |presentation| %>
      <%= link_to admin_project_design_presentation_path(@project, presentation),
            class: "block bg-white rounded-xl border border-theme-100 p-5 hover:border-theme-300 transition-colors" do %>
        <div class="flex items-center justify-between">
          <div>
            <div class="flex items-center gap-3">
              <h2 class="font-serif text-lg font-semibold text-theme-500"><%= presentation.title %></h2>
              <%= render "admin/shared/status_badge", status: presentation.status %>
            </div>
            <p class="text-sm text-gray-500 mt-1">
              <%= presentation.mood_boards.count %> mood boards ·
              <%= presentation.product_selections.count %> products ·
              <%= presentation.color_swatches.count %> colors
            </p>
          </div>
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-theme-100 p-8 text-center">
    <p class="text-gray-500">No presentations yet for this project.</p>
    <p class="text-sm text-gray-400 mt-1">Create one to start building the design concept.</p>
  </div>
<% end %>
