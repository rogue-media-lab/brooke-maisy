<% content_for(:title, "#{@presentation.title} - Builder") %>

<%= link_to admin_project_design_presentations_path(@project), class: "inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-theme-500 mb-4" do %>
  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
  All presentations
<% end %>

<%# Header: title, status, publish actions %>
<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="font-serif text-3xl font-semibold text-theme-500"><%= @presentation.title %></h1>
      <%= render "admin/shared/status_badge", status: @presentation.status %>
    </div>
    <p class="text-gray-500 mt-1"><%= @project.title %> · <%= @project.user.display_name %></p>
  </div>
  <div class="flex items-center gap-2">
    <% if @presentation.published? %>
      <%= button_to "Unpublish", admin_project_design_presentation_publication_path(@project, @presentation), method: :delete,
            class: "text-sm font-medium px-3 py-2 rounded-lg bg-theme-100 text-theme-500 hover:bg-theme-200 whitespace-nowrap cursor-pointer border-0 transition-colors" %>
    <% else %>
      <%= button_to "Publish", admin_project_design_presentation_publication_path(@project, @presentation), method: :post,
            class: "text-sm font-medium px-3 py-2 rounded-lg bg-theme-500 text-white hover:bg-theme-400 whitespace-nowrap cursor-pointer border-0 transition-colors" %>
    <% end %>
    <%= link_to "Edit title", edit_admin_project_design_presentation_path(@project, @presentation),
          class: "text-sm font-medium px-3 py-2 rounded-lg bg-white border border-theme-200 hover:border-theme-300 whitespace-nowrap transition-colors" %>
  </div>
</div>

<% if @presentation.published? %>
  <div class="bg-green-50 border border-green-200 rounded-lg px-4 py-3 mb-6">
    <p class="text-sm text-green-800">
      Published on <%= @presentation.published_at&.strftime("%b %-d, %Y at %I:%M %p") %>
    </p>
  </div>
<% end %>

<div class="space-y-4">
  <%# Mood Boards accordion %>
  <details class="group bg-white rounded-xl border border-theme-100 open:border-theme-300" open>
    <summary class="flex items-center justify-between cursor-pointer p-5 list-none">
      <div class="flex items-center gap-3">
        <h2 class="font-serif text-xl font-semibold text-theme-500">Mood Boards</h2>
        <span class="text-xs bg-theme-100 text-theme-500 px-2 py-0.5 rounded-full"><%= @mood_boards.count %></span>
      </div>
      <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
    </summary>
    <div class="px-5 pb-5 pt-0 border-t border-theme-100">
      <%= turbo_frame_tag "mood_boards_list" do %>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4" id="mood_boards_grid">
          <% @mood_boards.each do |board| %>
            <%= render "admin/mood_boards/mood_board_card", board: board, project: @project, presentation: @presentation %>
          <% end %>
        </div>
        <% if @mood_boards.empty? %>
          <p class="text-sm text-gray-400 mt-4" id="mood_boards_empty">No mood boards yet.</p>
        <% end %>
      <% end %>
      <div class="mt-4">
        <%= turbo_frame_tag "mood_board_form" do %>
          <%= link_to "New mood board", new_admin_project_design_presentation_mood_board_path(@project, @presentation),
                class: "inline-flex items-center gap-1.5 text-sm text-theme-500 hover:text-theme-400 font-medium" %>
        <% end %>
      </div>
    </div>
  </details>

  <%# Product Selections accordion %>
  <details class="group bg-white rounded-xl border border-theme-100 open:border-theme-300" open>
    <summary class="flex items-center justify-between cursor-pointer p-5 list-none">
      <div class="flex items-center gap-3">
        <h2 class="font-serif text-xl font-semibold text-theme-500">Product Selections</h2>
        <span class="text-xs bg-theme-100 text-theme-500 px-2 py-0.5 rounded-full"><%= @product_selections.count %></span>
      </div>
      <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
    </summary>
    <div class="px-5 pb-5 pt-0 border-t border-theme-100">
      <div class="space-y-3 mt-4" id="product_selections_list">
        <% if @product_selections.any? %>
          <% @product_selections.each do |product| %>
            <%= render "admin/product_selections/product_selection_card", product: product, project: @project, presentation: @presentation %>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-400" id="product_selections_empty">No product selections yet.</p>
        <% end %>
      </div>
      <div class="mt-4">
        <%= turbo_frame_tag "product_selection_form" do %>
          <%= link_to "Add product", new_admin_project_design_presentation_product_selection_path(@project, @presentation),
                class: "inline-flex items-center gap-1.5 text-sm text-theme-500 hover:text-theme-400 font-medium" %>
        <% end %>
      </div>
    </div>
  </details>

  <%# Color Palette accordion %>
  <details class="group bg-white rounded-xl border border-theme-100 open:border-theme-300" open>
    <summary class="flex items-center justify-between cursor-pointer p-5 list-none">
      <div class="flex items-center gap-3">
        <h2 class="font-serif text-xl font-semibold text-theme-500">Color Palette</h2>
        <span class="text-xs bg-theme-100 text-theme-500 px-2 py-0.5 rounded-full"><%= @color_swatches.count %></span>
      </div>
      <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
    </summary>
    <div class="px-5 pb-5 pt-0 border-t border-theme-100">
      <div class="flex flex-wrap gap-4 mt-4" id="color_swatches_list">
        <% if @color_swatches.any? %>
          <% @color_swatches.each do |swatch| %>
            <%= render "admin/color_swatches/color_swatch_card", swatch: swatch, project: @project, presentation: @presentation %>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-400" id="color_swatches_empty">No color swatches yet.</p>
        <% end %>
      </div>
      <div class="mt-4">
        <%= turbo_frame_tag "color_swatch_form" do %>
          <%= link_to "Add color", new_admin_project_design_presentation_color_swatch_path(@project, @presentation),
                class: "inline-flex items-center gap-1.5 text-sm text-theme-500 hover:text-theme-400 font-medium" %>
        <% end %>
      </div>
    </div>
  </details>
</div>
