<%= form_with model: [ :admin, @project, @presentation ],
      class: "bg-white rounded-xl border border-theme-100 p-6 space-y-5" do |f| %>

  <% if @presentation.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <p class="text-sm font-medium text-red-800 mb-1"><%= pluralize(@presentation.errors.count, "error") %> prohibited saving:</p>
      <ul class="text-sm text-red-700 list-disc list-inside">
        <% @presentation.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Presentation title", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, placeholder: "e.g. Initial Design Concept",
          class: "w-full rounded-lg border border-theme-200 px-3 py-2.5 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
  </div>

  <div class="flex items-center gap-3 pt-1">
    <%= f.submit (@presentation.persisted? ? "Update" : "Create"),
          class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-4 py-2 rounded-lg cursor-pointer transition-colors" %>
    <%= link_to "Cancel",
          @presentation.persisted? ? admin_project_design_presentation_path(@project, @presentation) : admin_project_design_presentations_path(@project),
          class: "text-sm text-gray-500 hover:text-theme-500 px-3 py-2" %>
  </div>
<% end %>
