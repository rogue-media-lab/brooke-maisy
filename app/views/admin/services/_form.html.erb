<%= form_with model: [:admin, service], class: "space-y-6" do |form| %>
  <% if service.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <p class="text-red-700 text-sm font-medium"><%= pluralize(service.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-2 list-disc list-inside text-red-600 text-sm">
        <% service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Identity</h3>
    <div class="space-y-4">
      <div>
        <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :title, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :description, rows: 3,
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= form.label :icon_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :icon_name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm",
              placeholder: "e.g. home, paint, sparkles" %>
      </div>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Bullet Points</h3>
    <p class="text-xs text-gray-400 mb-3">One per line. These appear as a list on the public page.</p>
    <%= form.text_area :bullet_points, rows: 6,
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono",
          placeholder: "Complete space planning\nFurniture selection & procurement\nColor palette development" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Settings</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :display_order, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :display_order, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-center gap-3 pt-6">
        <%= form.check_box :active, class: "rounded border-gray-300 text-theme-500 focus:ring-theme-400" %>
        <%= form.label :active, "Active (visible on public site)", class: "text-sm font-medium text-gray-700" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit service.persisted? ? "Save changes" : "Add service",
          class: "bg-theme-500 hover:bg-theme-400 text-white font-semibold px-6 py-2.5 rounded-lg cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_services_path,
          class: "text-gray-500 hover:text-gray-700 text-sm font-medium px-4 py-2.5" %>
  </div>
<% end %>