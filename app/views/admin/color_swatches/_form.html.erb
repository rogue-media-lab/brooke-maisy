<%= turbo_frame_tag "color_swatch_form" do %>
  <div class="bg-white rounded-lg border border-theme-100 p-4 mt-3">
    <%= form_with model: [ :admin, project, presentation, color_swatch ],
          class: "space-y-3" do |f| %>
      <% if color_swatch.errors.any? %>
        <div class="text-sm text-red-600">
          <%= color_swatch.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :name, "Color name", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, placeholder: "e.g. Versatile Gray",
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :hex_code, "Hex code", class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :hex_code, placeholder: "#B5A397",
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <%= f.label :brand, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :brand, placeholder: "e.g. Sherwin-Williams",
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :finish, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :finish, placeholder: "e.g. Matte",
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
        <div>
          <%= f.label :room, class: "block text-xs font-medium text-gray-700 mb-1" %>
          <%= f.text_field :room, placeholder: "e.g. Living Room",
                class: "w-full rounded-lg border border-theme-200 px-3 py-2 text-sm focus:border-theme-400 focus:ring-2 focus:ring-theme-200 focus:outline-none" %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= f.submit (color_swatch.persisted? ? "Update" : "Add"),
              class: "bg-theme-500 hover:bg-theme-400 text-white text-xs font-semibold px-3 py-1.5 rounded-lg cursor-pointer transition-colors" %>
        <%= link_to "Cancel",
              admin_project_design_presentation_path(project, presentation),
              class: "text-xs text-gray-500 hover:text-theme-500" %>
      </div>
    <% end %>
  </div>
<% end %>
