<%= form_with model: [:admin, @purchase_order], class: "space-y-6" do |f| %>
  <% unless params[:quote_id] %>
    <%= render "admin/clients/client_dropdown", form: f, field_name: :client_id, selected_id: @purchase_order.client_id, clients: @clients, return_to: request.fullpath %>
  <% end %>

  <div>
    <%= f.label :manufacturer_id, "Manufacturer", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :manufacturer_id, @manufacturers, :id, :name, { prompt: "Select manufacturer..." }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
  </div>

  <div>
    <%= f.label :quote_id, "Source Quote", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <% if params[:quote_id] %>
      <%= f.hidden_field :quote_id, value: params[:quote_id] %>
      <p class="text-sm text-gray-600"><%= Quote.find(params[:quote_id]).project.title %> — Quote #<%= params[:quote_id] %></p>
    <% else %>
      <%= f.collection_select :quote_id, @quotes, :id, ->(q) { "#{q.project.title} — Quote ##{q.id} (#{q.client.display_name})" }, { include_blank: "None" }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    <% end %>
    <p class="text-xs text-gray-400 mt-1">Only approved/ordered quotes shown. Selecting a quote auto-adds approved items.</p>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :order_date, "Order Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :order_date, value: @purchase_order.order_date || Date.current, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :expected_delivery, "Expected Delivery", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :expected_delivery, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "Internal notes, special instructions, PO number from manufacturer..." %>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_purchase_orders_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>