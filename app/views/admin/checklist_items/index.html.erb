<% content_for(:title, "Checklist - Admin") %>

<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="font-serif text-3xl font-semibold text-theme-500">Install Checklist</h1>
    <p class="text-gray-500 mt-1"><%= pluralize(@checklist_items.size, "item") %> — <%= @checklist_items.count(&:active?) %> active</p>
  </div>
  <%= link_to "Add item", new_admin_checklist_item_path,
        class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors" %>
</div>

<% if @checklist_items.any? %>
  <div class="bg-white rounded-xl border border-theme-100 overflow-hidden">
    <% @checklist_items.each do |item| %>
      <div class="flex items-center justify-between px-5 py-3 border-b border-gray-50 last:border-0 hover:bg-theme-100">
        <div class="flex items-center gap-3">
          <span class="text-xs text-gray-400 w-6"><%= item.position %></span>
          <span class="<%= item.active? ? "text-theme-500 font-medium" : "text-gray-400 line-through" %>">
            <%= item.name %>
          </span>
        </div>
        <div class="flex items-center gap-2">
          <% if item.active? %>
            <span class="inline-block w-2 h-2 rounded-full bg-green-500"></span>
          <% else %>
            <span class="text-xs text-gray-400">inactive</span>
          <% end %>
          <%= link_to "Edit", edit_admin_checklist_item_path(item),
                class: "text-xs text-theme-500 hover:text-theme-400 font-medium" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-theme-100 px-5 py-12 text-center">
    <p class="text-theme-500 font-medium">No checklist items yet</p>
    <p class="text-gray-500 text-sm mt-1">Add equipment and tools installers need to bring.</p>
  </div>
<% end %>