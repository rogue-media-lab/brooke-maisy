<%= form_with model: [:admin, checklist_item], class: "space-y-6" do |form| %>
  <% if checklist_item.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <p class="text-red-700 text-sm font-medium"><%= pluralize(checklist_item.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-2 list-disc list-inside text-red-600 text-sm">
        <% checklist_item.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white border border-gray-200 rounded-lg p-6">
    <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-4">Item Details</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm",
              placeholder: "e.g. Hand broom, cordless drill" %>
      </div>
      <div>
        <%= form.label :position, "Order", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :position, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
    </div>
    <div class="mt-4 flex items-center gap-3">
      <%= form.check_box :active, class: "rounded border-gray-300 text-theme-500 focus:ring-theme-400" %>
      <%= form.label :active, "Active (appears on tech checklist)", class: "text-sm font-medium text-gray-700" %>
    </div>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit checklist_item.persisted? ? "Save changes" : "Add item",
          class: "bg-theme-500 hover:bg-theme-400 text-white font-semibold px-6 py-2.5 rounded-lg cursor-pointer transition-colors" %>
    <%= link_to "Cancel", admin_checklist_items_path,
          class: "text-gray-500 hover:text-gray-700 text-sm font-medium px-4 py-2.5" %>
  </div>
<% end %>