<%= form_with model: [:admin, @product_category], class: "space-y-6" do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
  </div>
  <div>
    <%= f.label :slug, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :slug, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500 font-mono text-sm", required: true, placeholder: "cellular-shades" %>
  </div>
  <div>
    <%= f.label :parent_id, "Parent Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :parent_id, @parents, :id, :name, { include_blank: "None (top-level)" }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div>
    <%= f.label :markup_override, "Markup Override", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :markup_override, step: 0.01, min: 0, max: 2, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "0.35 = 35%" %>
    <p class="text-xs text-gray-400 mt-1">Leave blank to inherit from manufacturer or default.</p>
  </div>
  <div>
    <%= f.label :spec_template, "Spec Template", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :spec_template, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "cellular" %>
    <p class="text-xs text-gray-400 mt-1">YAML template name for the option configurator form.</p>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @product_category.persisted? ? admin_product_category_path(@product_category) : admin_product_categories_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>