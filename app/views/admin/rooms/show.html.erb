<% content_for(:title, "#{@room.name} — #{@room.project.title}") %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <%= link_to @room.project.title, admin_project_path(@room.project), class: "text-sm text-theme-500 hover:underline" %>
        <span class="text-gray-300">/</span>
        <%= link_to "Rooms", admin_project_rooms_path(@room.project), class: "text-sm text-theme-500 hover:underline" %>
      </div>
      <h1 class="font-serif text-2xl font-semibold text-theme-500"><%= @room.name %></h1>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_admin_project_room_path(@room.project, @room), class: "bg-theme-100 hover:bg-theme-200 text-theme-500 text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
      <%= button_to "Delete", admin_project_room_path(@room.project, @room), method: :delete, data: { turbo_confirm: "Remove #{@room.name}?" }, class: "bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-theme-100 p-8 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-serif text-lg font-semibold text-theme-500">Windows</h2>
      <%= link_to "Add window", new_admin_room_window_path(@room), class: "text-sm text-theme-500 hover:underline" %>
    </div>
    <% if @room.windows.any? %>
      <div class="space-y-2">
        <% @room.windows.ordered.each do |window| %>
          <%= link_to admin_room_window_path(@room, window), class: "flex items-center justify-between p-3 rounded-lg hover:bg-theme-100" do %>
            <div>
              <div class="text-sm font-medium text-theme-500"><%= window.name %></div>
              <div class="text-xs text-gray-400"><%= window.width %>″ × <%= window.height %>″ · <%= window.mount_type&.titleize || "—" %></div>
            </div>
            <span class="text-gray-300 text-xs">→</span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">No windows yet.</p>
    <% end %>
  </div>

  <% if @room.notes.present? %>
    <div class="bg-white rounded-xl border border-theme-100 p-8">
      <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Notes</h3>
      <p class="text-sm text-gray-600 whitespace-pre-wrap"><%= @room.notes %></p>
    </div>
  <% end %>
</div>