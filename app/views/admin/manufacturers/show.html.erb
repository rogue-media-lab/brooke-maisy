<% content_for(:title, "#{@manufacturer.name} - Admin") %>

<div class="max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <%= link_to admin_manufacturers_path, class: "text-sm text-gray-400 hover:text-theme-500 flex items-center gap-1" do %>
      ← Manufacturers
    <% end %>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_admin_manufacturer_path(@manufacturer), class: "bg-theme-100 hover:bg-theme-200 text-theme-500 text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
      <%= button_to "Delete", admin_manufacturer_path(@manufacturer), method: :delete,
            data: { turbo_confirm: "Remove #{@manufacturer.name}?" },
            class: "bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium px-4 py-2 rounded-lg transition-colors" %>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-theme-100 overflow-hidden">
    <div class="p-8">
      <h1 class="font-serif text-2xl font-semibold text-theme-500 mb-6"><%= @manufacturer.name %></h1>
      <dl class="grid grid-cols-2 gap-6">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Website</dt>
          <dd class="text-sm text-theme-500"><%= link_to @manufacturer.website, @manufacturer.website, target: "_blank", class: "hover:underline" if @manufacturer.website.present? || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Trade Program</dt>
          <dd class="text-sm text-gray-600"><%= @manufacturer.trade_program_url.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Trade Discount</dt>
          <dd class="text-sm text-gray-600"><%= @manufacturer.trade_discount ? "#{(@manufacturer.trade_discount * 100).round}%" : "—" %></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">Markup Override</dt>
          <dd class="text-sm text-gray-600"><%= @manufacturer.markup_override ? "#{(@manufacturer.markup_override * 100).round}%" : "default" %></dd>
        </div>
      </dl>
      <% if @manufacturer.notes.present? %>
        <div class="mt-6 pt-6 border-t border-gray-100">
          <dt class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Notes</dt>
          <dd class="text-sm text-gray-600 whitespace-pre-wrap"><%= @manufacturer.notes %></dd>
        </div>
      <% end %>
    </div>
  </div>
</div>