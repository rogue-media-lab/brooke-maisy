<% content_for(:title, "Edit #{@manufacturer.name} - Admin") %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <%= link_to admin_manufacturer_path(@manufacturer), class: "text-sm text-gray-400 hover:text-theme-500" do %>
      ← Back to <%= @manufacturer.name %>
    <% end %>
  </div>
  <h1 class="font-serif text-2xl font-semibold text-theme-500 mb-8">Edit Manufacturer</h1>
  <div class="bg-white rounded-xl border border-theme-100 p-8">
    <%= render "form" %>
  </div>
</div>