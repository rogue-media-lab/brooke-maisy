<%= form_with model: [:admin, @manufacturer], class: "space-y-6" do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
  </div>
  <div>
    <%= f.label :website, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :website, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "https://" %>
  </div>
  <div>
    <%= f.label :trade_program_url, "Trade Program URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.url_field :trade_program_url, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "https://" %>
  </div>
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :trade_discount, "Trade Discount", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :trade_discount, step: 0.01, min: 0, max: 1, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "0.20 = 20%" %>
      <p class="text-xs text-gray-400 mt-1">Decimal: 0.20 = 20%</p>
    </div>
    <div>
      <%= f.label :markup_override, "Markup Override", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :markup_override, step: 0.01, min: 0, max: 2, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "0.40 = 40%" %>
      <p class="text-xs text-gray-400 mt-1">Leave blank to use default.</p>
    </div>
  </div>
  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 4, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @manufacturer.persisted? ? admin_manufacturer_path(@manufacturer) : admin_manufacturers_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>