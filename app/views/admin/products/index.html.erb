<% content_for(:title, "Products - Admin") %>

<div class="flex items-center justify-between mb-8">
  <div>
    <h1 class="font-serif text-3xl font-semibold text-theme-500">Products</h1>
    <p class="text-gray-500 mt-1"><%= pluralize(@products.size, "product") %></p>
  </div>
  <%= link_to "Add product", new_admin_product_path,
        class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors" %>
</div>

<% if @products.any? %>
  <div class="bg-white rounded-xl border border-theme-100 overflow-hidden">
    <div class="grid grid-cols-12 px-5 py-3 bg-theme-100 text-[11px] font-semibold uppercase tracking-wider text-gray-400">
      <div class="col-span-4">Name</div>
      <div class="col-span-2">Manufacturer</div>
      <div class="col-span-2">Category</div>
      <div class="col-span-1">Tier</div>
      <div class="col-span-2">Price</div>
      <div class="col-span-1">Active</div>
    </div>
    <% @products.each do |product| %>
      <%= link_to admin_product_path(product), class: "grid grid-cols-12 px-5 py-4 items-center border-b border-gray-50 last:border-0 hover:bg-theme-100" do %>
        <div class="col-span-4 font-medium text-theme-500 truncate pr-2"><%= product.name %></div>
        <div class="col-span-2 text-sm text-gray-500"><%= product.manufacturer.name %></div>
        <div class="col-span-2 text-sm text-gray-500"><%= product.product_category.name %></div>
        <div class="col-span-1 text-sm text-gray-400"><%= product.tier || "—" %></div>
        <div class="col-span-2 text-sm text-gray-600"><%= number_to_currency(product.pricing&.dig("base_cost") || 0) %></div>
        <div class="col-span-1 text-right"><span class="inline-block w-2 h-2 rounded-full <%= product.is_active ? 'bg-green-500' : 'bg-gray-300' %>"></span></div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-theme-100 p-12 text-center text-gray-400">
    <p>No products yet. Add one to start building your catalog.</p>
  </div>
<% end %>