<%= form_with model: [:admin, @product], class: "space-y-6" do |f| %>
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :manufacturer_id, "Manufacturer", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :manufacturer_id, @manufacturers, :id, :name, { prompt: "Select..." }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
    </div>
    <div>
      <%= f.label :product_category_id, "Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :product_category_id, @categories, :id, :name, { prompt: "Select..." }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
    </div>
  </div>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :product_url, "Product URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :product_url, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "https://" %>
    </div>
    <div>
      <%= f.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :unit, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "per window" %>
    </div>
    <div>
      <%= f.label :lead_time_days, "Lead Time (days)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :lead_time_days, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :tier, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :tier, [["Easy In", 1], ["Research", 2], ["Bulk Import", 3]], { include_blank: true }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div class="flex items-center pt-6">
      <%= f.check_box :is_active, class: "rounded border-gray-300 text-theme-500 focus:ring-theme-500" %>
      <%= f.label :is_active, "Active", class: "ml-2 text-sm text-gray-700" %>
    </div>
  </div>
  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @product.persisted? ? admin_product_path(@product) : admin_products_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>