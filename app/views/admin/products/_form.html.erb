<%= form_with model: [:admin, @product], class: "space-y-6" do |f| %>
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :manufacturer_id, "Manufacturer", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :manufacturer_id, @manufacturers, :id, :name, { prompt: "Select..." }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
    </div>
    <div>
      <%= f.label :product_category_id, "Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :product_category_id, @categories, :id, :name, { prompt: "Select..." }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
    </div>
  </div>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :product_url, "Product URL", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.url_field :product_url, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "https://" %>
    </div>
    <div>
      <%= f.label :unit, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :unit, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "per window" %>
    </div>
    <div>
      <%= f.label :lead_time_days, "Lead Time (days)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :lead_time_days, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :tier, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :tier, [["Easy In", 1], ["Research", 2], ["Bulk Import", 3]], { include_blank: true }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div class="flex items-center pt-6">
      <%= f.check_box :is_active, class: "rounded border-gray-300 text-theme-500 focus:ring-theme-500" %>
      <%= f.label :is_active, "Active", class: "ml-2 text-sm text-gray-700" %>
    </div>
  </div>
  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div data-controller="product-pricing" class="space-y-4 pt-4 border-t border-gray-100">
    <div>
      <h3 class="text-sm font-semibold text-theme-500">Pricing Reference Points</h3>
      <p class="mt-1 text-xs text-gray-500">Enter the vendor's price for each standard window size. Leave blank if the vendor doesn't offer that size.</p>
    </div>

    <div data-product-pricing-target="container" class="space-y-3">
      <% pricing = @product.pricing || {} %>
      <% existing_points = (pricing["price_points"] || []).index_by { |p| [ p["width"].to_i, p["height"].to_i ] } %>
      <% StandardWindowSize::SIZES.each do |size| %>
        <% point = existing_points[[ size[:width], size[:height] ]] %>
        <div data-price-point class="grid grid-cols-12 gap-3 items-center">
          <div class="col-span-3">
            <label class="block text-xs font-medium text-gray-500 mb-1">Width</label>
            <div class="flex items-center h-10 px-3 rounded-lg bg-gray-50 text-sm text-gray-700">
              <%= size[:width] %>″
              <%= hidden_field_tag "product[pricing][price_points][][width]", size[:width] %>
            </div>
          </div>
          <div class="col-span-3">
            <label class="block text-xs font-medium text-gray-500 mb-1">Height</label>
            <div class="flex items-center h-10 px-3 rounded-lg bg-gray-50 text-sm text-gray-700">
              <%= size[:height] %>″
              <%= hidden_field_tag "product[pricing][price_points][][height]", size[:height] %>
            </div>
          </div>
          <div class="col-span-4">
            <label class="block text-xs font-medium text-gray-500 mb-1">Cost</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 text-sm">$</span>
              <%= text_field_tag "product[pricing][price_points][][cost]", point ? point["cost"] : "", type: :number, step: "0.01", min: 0, placeholder: "0.00", class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500 pl-7" %>
            </div>
          </div>
          <div class="col-span-2 flex justify-end">
            <button type="button" class="text-xs text-gray-400 hover:text-red-500" data-action="click->product-pricing#removePoint">Remove</button>
          </div>
        </div>
      <% end %>
    </div>

    <div>
      <button type="button" class="text-sm text-theme-500 hover:text-theme-400" data-action="click->product-pricing#addPoint">+ Add custom size</button>
    </div>

    <div class="grid grid-cols-2 gap-6 pt-4 border-t border-gray-100">
      <div>
        <%= label_tag "product[pricing][height_factor]", "Height Factor", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= number_field_tag "product[pricing][height_factor]", pricing["height_factor"].presence || 0.5, step: 0.1, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
        <p class="mt-1 text-xs text-gray-500">Adjusts cost when actual height differs from the reference size.</p>
      </div>
      <div>
        <%= label_tag "product[pricing][last_verified]", "Last Verified", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= date_field_tag "product[pricing][last_verified]", pricing["last_verified"], class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
      </div>
    </div>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @product.persisted? ? admin_product_path(@product) : admin_products_path, class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>