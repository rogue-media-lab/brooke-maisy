<%= form_with model: [:admin, @quote.project, @quote, @quote_line_item],
      class: "space-y-6",
      data: { controller: "quote-calculator" } do |f| %>

  <%# Product search (replaces collection_select) %>
  <div class="grid grid-cols-2 gap-6">
    <div data-controller="product-search" class="relative">
      <%= f.label :product_id, "Product", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.hidden_field :product_id, data: { product_search_target: "hidden" } %>
      <input type="text"
             data-product-search-target="input"
             data-action="input->product-search#search blur->product-search#blur"
             placeholder="Type to search products..."
             class="w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500"
             autocomplete="off">
      <div data-product-search-target="results"
           class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
      </div>
    </div>
    <div>
      <%= f.label :window_id, "Window", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :window_id, @windows, :id, :name, { include_blank: "None" }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
  </div>

  <%# Dynamic option configurator (renders when product is selected) %>
  <div data-controller="option-configurator"
       data-action="product-search:selected->option-configurator#configure option-configurator:updated->quote-calculator#calculate"
       data-option-configurator-target="container">
  </div>

  <%# Swatch picker %>
  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Color / Swatch</label>
    <% if @swatches.any? %>
      <div data-controller="swatch-picker" class="grid grid-cols-6 sm:grid-cols-8 gap-2">
        <%= f.hidden_field :swatch_id, data: { swatch_picker_target: "hidden" } %>
        <% @swatches.each do |swatch| %>
          <button type="button"
                  data-swatch-picker-target="swatch"
                  data-swatch-id="<%= swatch.id %>"
                  data-action="click->swatch-picker#select"
                  class="w-full aspect-square rounded-lg border border-gray-200 hover:border-theme-400 transition-all cursor-pointer"
                  style="background-color: <%= swatch.hex || '#e5e5e5' %>"
                  title="<%= swatch.name %>">
          </button>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400 italic">No swatches available. Add swatches in the inventory section.</p>
    <% end %>
  </div>

  <%# Description fallback %>
  <div>
    <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :description, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "Fallback if no product selected" %>
  </div>

  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :width, "Width (in)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :width, step: 0.125, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :height, "Height (in)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :height, step: 0.125, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :quantity, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :quantity, value: 1, min: 1, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", data: { quote_calculator_target: "quantity", action: "change->quote-calculator#calculate" } %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= f.label :unit_cost, "Unit Cost ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :unit_cost, step: 0.01, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", data: { quote_calculator_target: "unitCost", action: "change->quote-calculator#calculate" } %>
      <p class="text-xs text-gray-400 mt-1">What Amanda pays.</p>
    </div>
    <div>
      <%= f.label :unit_price, "Unit Price ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :unit_price, step: 0.01, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", data: { quote_calculator_target: "unitPrice" } %>
      <p class="text-xs text-gray-400 mt-1">What client pays (auto-filled from cost + markup).</p>
    </div>
  </div>

  <%# Live cost preview %>
  <div class="bg-theme-50 rounded-lg p-4" data-quote-calculator-target="costPreview">
    <p class="text-sm text-gray-400">Enter unit cost and quantity to see preview.</p>
  </div>
  <div class="text-xs text-gray-400" data-quote-calculator-target="upchargeTotal"></div>

  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :discount_type, "Discount Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :discount_type, [["None", ""], ["Percentage", "percentage"], ["Fixed $", "fixed"]], {}, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :discount_value, "Discount Value", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :discount_value, step: 0.01, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :discount_reason, "Reason", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :discount_reason, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "Friends & family" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 2, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>

  <div>
    <%= f.label :comparison_group, "Comparison Group", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :comparison_group, [["None", ""], ["Good", "Good"], ["Better", "Better"], ["Best", "Best"]], {}, class: "w-48 rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    <p class="text-xs text-gray-400 mt-1">Group items for good/better/best comparison on client view.</p>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_project_quote_path(@quote.project, @quote), class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>