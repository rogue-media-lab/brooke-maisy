<%= form_with model: [:admin, @quote, @quote_line_item],
      class: "space-y-6",
      data: { controller: "quote-calculator" } do |f| %>

  <%# Coordinator wrapper: product-search:selected events bubble here
       where both option-configurator and swatch-picker can catch them.
       option-configurator:updated bubbles up to quote-calculator on the form. %>
  <div data-controller="option-configurator swatch-picker"
       data-action="product-search:selected->option-configurator#configure product-search:selected->swatch-picker#loadSwatches product-search:selected->quote-calculator#loadPricing option-configurator:updated->quote-calculator#calculate"
       data-swatch-picker-swatches-url-value="/admin/products"
       data-option-configurator-saved-options-value="<%= @quote_line_item.selected_options&.to_json || '{}' %>"
       data-swatch-picker-saved-swatch-id-value="<%= @quote_line_item.swatch_id || '' %>"
       class="space-y-6">

    <%# Manufacturer + Product search %>
    <div data-controller="product-search" class="grid grid-cols-3 gap-6">
      <div>
        <%= label_tag :manufacturer_filter, "Manufacturer", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= select_tag :manufacturer_filter,
              options_from_collection_for_select(@manufacturers, :id, :name),
              { include_blank: "All Manufacturers",
                data: { product_search_target: "manufacturer", action: "change->product-search#search" },
                class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" } %>
        <p class="text-xs text-gray-400 mt-1">Filter products by vendor.</p>
      </div>
      <div class="relative col-span-2">
        <%= f.label :product_id, "Product", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.hidden_field :product_id, data: { product_search_target: "hidden" } %>
        <input type="text"
               data-product-search-target="input"
               data-action="input->product-search#search blur->product-search#blur focus->product-search#focus"
               placeholder="Type to search, or click to browse..."
               class="w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500"
               autocomplete="off">
        <div data-product-search-target="results"
             class="hidden absolute z-10 w-full mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto">
        </div>
      </div>
    </div>

    <div data-controller="window-autofill">
      <%= f.label :window_id, "Window", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :window_id,
            options_for_select(@windows.map { |w| [w.name, w.id, { "data-width" => w.width, "data-height" => w.height, "data-mount" => w.mount_type }] }, selected: f.object.window_id),
            { include_blank: "None" },
            { class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500",
              data: { action: "change->window-autofill#fill" } } %>
      <p class="text-xs text-gray-400 mt-1">Selecting a window auto-fills dimensions from the measurement step.</p>
    </div>

    <%# Dynamic option configurator (renders when product is selected) %>
    <div data-option-configurator-target="container">
    </div>

    <%# Swatch picker — filtered by selected product %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Color / Swatch</label>
      <%= f.hidden_field :swatch_id, data: { swatch_picker_target: "hidden" } %>
      <div data-swatch-picker-target="grid" class="grid grid-cols-6 sm:grid-cols-8 gap-2">
        <p class="text-sm text-gray-400 italic col-span-full">Select a product to see available colors.</p>
      </div>
    </div>
  </div>

  <%# Description fallback %>
  <div>
    <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :description, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "Fallback if no product selected" %>
  </div>

  <%# Location — freeform at quote time, used to auto-create rooms on project conversion %>
  <div>
    <%= f.label :location, "Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :location, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "e.g., Living Room - north - 1" %>
    <p class="text-xs text-gray-400 mt-1">Where this item goes. Used to create rooms when converting to a project.</p>
  </div>

  <%# Dimensions — with quote-calculator targets for live pricing %>
  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :width, "Width (in)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :width, step: 0.125, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500",
            data: { quote_calculator_target: "width", action: "input->quote-calculator#calculate" } %>
    </div>
    <div>
      <%= f.label :height, "Height (in)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :height, step: 0.125, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500",
            data: { quote_calculator_target: "height", action: "input->quote-calculator#calculate" } %>
    </div>
    <div>
      <%= f.label :quantity, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :quantity, value: 1, min: 1, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500",
            data: { quote_calculator_target: "quantity", action: "change->quote-calculator#calculate" } %>
    </div>
  </div>

  <%# Mount adjustment indicator — shows when outside mount changes the actual blind size %>
  <div data-quote-calculator-target="mountInfo" class="hidden">
  </div>

  <%# Verified Cost (optional override) %>
  <div>
    <%= f.label :override_cost, "Verified Cost (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :override_cost, step: 0.01, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500",
          data: { quote_calculator_target: "overrideCost", action: "input->quote-calculator#calculate" } %>
    <p class="text-xs text-gray-400 mt-1">Only if you have an exact price from the vendor. Overrides auto-calculation.</p>
  </div>

  <%# Hidden cost fields — computed by quote-calculator, set server-side by PricingCalculator %>
  <%= f.hidden_field :unit_cost, data: { quote_calculator_target: "unitCost" } %>
  <%= f.hidden_field :unit_price, data: { quote_calculator_target: "unitPrice" } %>

  <%# Client Price — auto-calculated, shown to customer %>
  <div class="bg-theme-50 rounded-lg p-4" data-quote-calculator-target="priceDisplay">
    <p class="text-sm text-gray-400">Select a product and enter dimensions to see price.</p>
  </div>
  <div class="text-xs text-gray-400" data-quote-calculator-target="upchargeTotal"></div>

  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :discount_type, "Discount Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :discount_type, [["None", ""], ["Percentage", "percentage"], ["Fixed $", "fixed"]], {}, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :discount_value, "Discount Value", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :discount_value, step: 0.01, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    </div>
    <div>
      <%= f.label :discount_reason, "Reason", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :discount_reason, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "Friends & family" %>
    </div>
  </div>

  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 2, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>

  <div>
    <%= f.label :comparison_group, "Comparison Group", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :comparison_group, [["None", ""], ["Good", "Good"], ["Better", "Better"], ["Best", "Best"]], {}, class: "w-48 rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
    <p class="text-xs text-gray-400 mt-1">Group items for good/better/best comparison on client view.</p>
  </div>

  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_quote_path(@quote), class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>