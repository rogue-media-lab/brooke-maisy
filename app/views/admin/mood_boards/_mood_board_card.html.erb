<div class="bg-white rounded-lg border border-theme-100 p-4" id="<%= dom_id(board) %>">
  <div class="flex items-start justify-between gap-2 mb-3">
    <h3 class="font-serif text-base font-semibold text-theme-500"><%= board.name %></h3>
    <div class="flex items-center gap-1">
      <%= button_to move_admin_project_design_presentation_mood_board_path(project, presentation, board), method: :patch,
            params: { direction: "up" },
            class: "text-gray-300 hover:text-theme-500 bg-transparent border-0 p-1 cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
      <% end %>
      <%= button_to move_admin_project_design_presentation_mood_board_path(project, presentation, board), method: :patch,
            params: { direction: "down" },
            class: "text-gray-300 hover:text-theme-500 bg-transparent border-0 p-1 cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
      <% end %>
      <%= link_to edit_admin_project_design_presentation_mood_board_path(project, presentation, board),
            class: "text-gray-300 hover:text-theme-500 p-1", data: { turbo_frame: "mood_board_form" } do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
      <% end %>
      <%= button_to admin_project_design_presentation_mood_board_path(project, presentation, board), method: :delete,
            form: { data: { turbo_confirm: "Delete this mood board?" } },
            class: "text-gray-300 hover:text-red-500 bg-transparent border-0 p-1 cursor-pointer" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "mood_board_items_#{board.id}" do %>
    <% items = board.mood_board_items.ordered %>
    <% if items.any? %>
      <div class="grid grid-cols-2 gap-2" id="mood_board_items_grid_<%= board.id %>">
        <% items.each do |item| %>
          <div class="aspect-square rounded-md overflow-hidden bg-gray-100 relative group" id="<%= dom_id(item) %>">
            <% if item.image.attached? %>
              <%= image_tag item.image, class: "w-full h-full object-cover", loading: "lazy" %>
            <% else %>
              <div class="w-full h-full flex items-center justify-center text-gray-300">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
            <% end %>
            <% if item.caption.present? %>
              <span class="absolute bottom-0 left-0 right-0 bg-black/50 text-white text-[10px] px-2 py-1 truncate"><%= item.caption %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-gray-400" id="mood_board_items_empty_<%= board.id %>">No items yet.</p>
    <% end %>
  <% end %>

  <div class="mt-3">
    <%= link_to "Add item", new_admin_project_design_presentation_mood_board_mood_board_item_path(project, presentation, board),
          class: "text-xs text-theme-500 hover:text-theme-400 font-medium",
          data: { turbo_frame: "mood_board_item_form_#{board.id}" } %>
  </div>
  <%= turbo_frame_tag "mood_board_item_form_#{board.id}" %>
</div>
