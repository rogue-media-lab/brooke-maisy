<% content_for(:title, "Documents - #{@quote.client&.display_name}") %>

<% content_for(:stepper) do %>
  <%= render "admin/quotes/stepper", quote: @quote %>
<% end %>

<div class="mb-6">
  <div class="flex items-center gap-2 mb-1">
    <%= link_to "Quotes", admin_quotes_path, { class: "text-sm text-theme-500 hover:underline" } %>
    <span class="text-gray-300">/</span>
    <%= link_to "Quote ##{@quote.id}", admin_quote_path(@quote), { class: "text-sm text-theme-500 hover:underline" } %>
  </div>
  <h1 class="font-serif text-2xl font-semibold text-theme-500">Documents</h1>
  <p class="text-sm text-gray-400"><%= @quote.client&.display_name %> - Quote #<%= @quote.id %></p>
</div>

<div class="bg-white rounded-xl border border-theme-100 overflow-hidden mb-8">
  <div class="px-5 py-3 bg-theme-100">
    <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Generate Forms</span>
  </div>
  <div class="p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
    <% Admin::QuoteDocumentsController::FORMS.each do |key, form| %>
      <div class="border border-theme-100 rounded-lg p-4 flex items-center justify-between hover:border-theme-300 transition-colors">
        <div>
          <p class="text-sm font-medium text-theme-500"><%= form[:label] %></p>
          <p class="text-xs text-gray-400 mt-0.5">PDF - Auto-filled from quote data</p>
        </div>
        <%= link_to "Generate", download_admin_documents_path(@quote, form: key), { target: "_blank", class: "bg-theme-500 hover:bg-theme-400 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors" } %>
      </div>
    <% end %>
  </div>
</div>

<div class="bg-white rounded-xl border border-theme-100 overflow-hidden mb-8">
  <div class="px-5 py-3 bg-theme-100">
    <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-400">Signature Status</span>
  </div>
  <div class="p-5">
    <% if @signatures.any? %>
      <div class="space-y-2">
        <% @signatures.each do |sig| %>
          <div class="flex items-center justify-between text-sm">
            <div>
              <span class="font-medium text-theme-500"><%= sig.document_type.humanize %></span>
              <span class="text-gray-400 ml-2">- <%= sig.signer.humanize %></span>
            </div>
            <div class="text-right">
              <span class="text-gray-600"><%= sig.signed_name %></span>
              <span class="text-gray-400 ml-2"><%= sig.signed_at&.strftime("%b %d, %Y") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-400 text-sm">No signatures recorded yet. Generate the agreement above, then use the signing flow to capture client and designer signatures.</p>
    <% end %>
  </div>
</div>

<%# Signing flow entry %>
<%
  client_sig = @quote.signatures.where(document_type: :agreement, signer: :client).first
  designer_sig = @quote.signatures.where(document_type: :agreement, signer: :designer).first
%>
<div class="bg-white rounded-xl border border-theme-100 p-5">
  <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">Signatures</h3>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%# Client signing %>
    <div class="border rounded-lg p-4 <%= client_sig ? 'border-green-300 bg-green-50' : 'border-theme-100' %>">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium <%= client_sig ? 'text-green-700' : 'text-theme-500' %>">Client Signature</span>
        <% if client_sig %>
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        <% end %>
      </div>
      <% if client_sig %>
        <p class="text-xs text-green-600">Signed by <%= client_sig.signed_name %> on <%= client_sig.signed_at&.strftime("%b %d, %Y") %></p>
        <p class="text-xs text-green-600 mt-1">Quote is locked.</p>
      <% else %>
        <p class="text-xs text-gray-400 mb-3">Hand the iPad to the client to sign.</p>
        <%= link_to "Start Client Signing", sign_admin_documents_path(@quote),
            { class: "bg-theme-100 hover:bg-theme-200 text-theme-500 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors" } %>
      <% end %>
    </div>

    <%# Designer signing %>
    <div class="border rounded-lg p-4 <%= designer_sig ? 'border-green-300 bg-green-50' : 'border-theme-100' %>">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium <%= designer_sig ? 'text-green-700' : 'text-theme-500' %>">Designer Signature</span>
        <% if designer_sig %>
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        <% end %>
      </div>
      <% if designer_sig %>
        <p class="text-xs text-green-600">Signed by <%= designer_sig.signed_name %> on <%= designer_sig.signed_at&.strftime("%b %d, %Y") %></p>
      <% else %>
        <p class="text-xs text-gray-400 mb-3">Amanda signs after the client.</p>
        <%= link_to "Start Designer Signing", sign_designer_admin_documents_path(@quote),
            { class: "bg-theme-100 hover:bg-theme-200 text-theme-500 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors" } %>
      <% end %>
    </div>
  </div>
</div>
