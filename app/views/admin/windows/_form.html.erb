<%= form_with model: [:admin, @room.project, @room, @window], class: "space-y-6" do |f| %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", required: true, placeholder: "North wall — large" %>
  </div>
  <div class="grid grid-cols-3 gap-6">
    <div>
      <%= f.label :width, "Width (inches)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :width, step: 0.125, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "48" %>
    </div>
    <div>
      <%= f.label :height, "Height (inches)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :height, step: 0.125, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "60" %>
    </div>
    <div>
      <%= f.label :depth, "Depth (inches)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :depth, step: 0.125, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "2.5" %>
    </div>
  </div>
  <div>
    <%= f.label :mount_type, "Mount Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :mount_type, [["Inside", "inside"], ["Outside", "outside"]], { include_blank: true }, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div>
    <%= f.label :photo, "Window Photo", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.file_field :photo, class: "w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-theme-100 file:text-theme-500 hover:file:bg-theme-200" %>
  </div>
  <div>
    <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500", placeholder: "Obstructions, trim style, casing notes" %>
  </div>
  <div>
    <%= f.label :position, "Display Order", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :position, class: "w-full rounded-lg border-gray-300 focus:border-theme-500 focus:ring-theme-500" %>
  </div>
  <div class="flex gap-3">
    <%= f.submit class: "bg-theme-500 hover:bg-theme-400 text-white text-sm font-semibold px-6 py-2.5 rounded-lg transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @window.persisted? ? admin_project_room_window_path(@room.project, @room, @window) : admin_project_room_windows_path(@room.project, @room), class: "text-sm text-gray-500 hover:text-gray-700 py-2.5" %>
  </div>
<% end %>